{
  "description": "Open Notepad and type Hello World",
  "events": [
    {
      "type": "keyboard",
      "action": "hotkey",
      "keys": ["win", "r"]
    },
    {
      "type": "delay",
      "ms": 500
    },
    {
      "type": "keyboard",
      "action": "text",
      "value": "notepad"
    },
    {
      "type": "keyboard",
      "action": "hotkey",
      "keys": ["enter"]
    },
    {
      "type": "delay",
      "ms": 1500
    },
    {
      "type": "keyboard",
      "action": "text",
      "value": "Hello World from FlexKVM"
    },
    {
      "type": "delay",
      "ms": 300
    }
  ]
}