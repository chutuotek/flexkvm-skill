{
  "description": "Mouse move, click, double-click and scroll demo",
  "events": [
    {
      "type": "move",
      "x": 0.5,
      "y": 0.5
    },
    {
      "type": "delay",
      "ms": 200
    },
    {
      "type": "click",
      "button": "left",
      "x": 0.5,
      "y": 0.5
    },
    {
      "type": "delay",
      "ms": 300
    },
    {
      "type": "dblclick",
      "button": "left",
      "x": 0.6,
      "y": 0.4
    },
    {
      "type": "delay",
      "ms": 300
    },
    {
      "type": "scroll",
      "dy": 3
    },
    {
      "type": "delay",
      "ms": 200
    },
    {
      "type": "scroll",
      "dy": -3
    },
    {
      "type": "delay",
      "ms": 200
    },
    {
      "type": "click",
      "button": "right",
      "x": 0.3,
      "y": 0.7
    }
  ]
}